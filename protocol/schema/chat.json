{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echogrid.dev/schema/chat.json",
  "title": "Echo Grid - chat + presence messages",
  "oneOf": [
    { "$ref": "#/$defs/messageSend" },
    { "$ref": "#/$defs/messageNew" },
    { "$ref": "#/$defs/typingStart" },
    { "$ref": "#/$defs/presenceUpdate" },
    { "$ref": "#/$defs/readAck" },
    { "$ref": "#/$defs/readMarkUnread" },
    { "$ref": "#/$defs/readUpdated" }
  ],
  "$defs": {
    "messageSend": {
      "description": "Client -> server: post a new message in a channel.",
      "type": "object",
      "required": ["type", "channelId", "content"],
      "properties": {
        "type":          { "const": "message.send" },
        "channelId":     { "type": "integer", "minimum": 1 },
        "content":       { "type": "string", "maxLength": 4000 },
        "attachmentIds": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "embeds": {
          "description": "Each url may appear at most once; a repeated url is refused with error { code: 'bad_request' }, because clients key a message's embeds by url.",
          "type": ["array", "null"],
          "items": { "$ref": "common.json#/$defs/embedRef" },
          "maxItems": 4
        }
      }
    },
    "messageNew": {
      "description": "Server -> every-client-in-channel: a new message.",
      "type": "object",
      "required": ["type", "id", "channelId", "author", "content", "ts"],
      "properties": {
        "type":        { "const": "message.new" },
        "id":          { "type": "integer", "minimum": 1 },
        "channelId":   { "type": "integer", "minimum": 1 },
        "author":      { "$ref": "common.json#/$defs/messageAuthor" },
        "content":     { "type": "string" },
        "attachments": {
          "type": ["array", "null"],
          "items": { "$ref": "common.json#/$defs/attachmentRef" }
        },
        "embeds": {
          "description": "Unique by url - the server drops a repeat on every read path, so clients may key on it.",
          "type": ["array", "null"],
          "items": { "$ref": "common.json#/$defs/embedRef" }
        },
        "ts": { "$ref": "common.json#/$defs/timestamp" }
      }
    },
    "typingStart": {
      "description": "Client -> server: 'I am typing in this channel'.",
      "type": "object",
      "required": ["type", "channelId"],
      "properties": {
        "type":      { "const": "typing.start" },
        "channelId": { "type": "integer", "minimum": 1 }
      }
    },
    "presenceUpdate": {
      "description": "Server -> everyone: presence state changed for a member.",
      "type": "object",
      "required": ["type", "identityId", "state"],
      "properties": {
        "type":       { "const": "presence.update" },
        "identityId": { "type": "integer", "minimum": 1 },
        "state":      { "$ref": "common.json#/$defs/presenceState" },
        "onMobile":   { "$ref": "common.json#/$defs/onMobile" }
      }
    },
    "readAck": {
      "description": "Client -> server: I have read this channel up to this message. Forward-only - an id behind the stored pointer changes nothing.",
      "type": "object",
      "required": ["type", "channelId", "messageId"],
      "properties": {
        "type":      { "const": "read.ack" },
        "channelId": { "type": "integer", "minimum": 1 },
        "messageId": {
          "description": "The newest message id the client holds and has shown. Null means 'through the newest message', for mark-all-read, where the client may not hold it.",
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "readMarkUnread": {
      "description": "Client -> server: treat this message and everything after it as unread. The one write that moves the pointer backwards; mention counts are left as they are.",
      "type": "object",
      "required": ["type", "channelId", "messageId"],
      "properties": {
        "type":      { "const": "read.mark_unread" },
        "channelId": { "type": "integer", "minimum": 1 },
        "messageId": { "type": "integer", "minimum": 1 }
      }
    },
    "readUpdated": {
      "description": "Server -> every session of the identity: a read changed. Sent only when something actually changed, and to the originating session too, so all devices converge on the server's answer.",
      "type": "object",
      "required": ["type", "channelId", "lastReadMessageId", "unreadCount", "mentionCount"],
      "properties": {
        "type":              { "const": "read.updated" },
        "channelId":         { "type": "integer", "minimum": 1 },
        "lastReadMessageId": { "type": "integer", "minimum": 0 },
        "unreadCount":       { "type": "integer", "minimum": 0, "maximum": 100 },
        "mentionCount":      { "type": "integer", "minimum": 0 }
      }
    }
  }
}
