# Caddy reverse proxy: TLS on $ECHOGRID_DOMAIN, /livekit/* to livekit-server on
# :7880 (prefix stripped, Host kept for its signaling), everything else to :5162.

# Behind Cloudflare, uncomment this, or Echo Grid sees every user as a CF edge
# address (rate limits and IP bans key on it). Ranges from
# https://www.cloudflare.com/ips-v4 and /ips-v6 (fetched 2026-10-06).
#{
#    servers {
#        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
#        client_ip_headers CF-Connecting-IP
#    }
#}

# Set ECHOGRID_DOMAIN in the stack env. Unset, Caddy fails with a misleading
# "unrecognized global option: handle_path". No default on purpose: a wrong
# hostname fails quietly at certificate time.
{$ECHOGRID_DOMAIN} {
    handle_path /livekit/* {
        reverse_proxy 127.0.0.1:7880 {
            header_up Host {host}
            transport http {
                versions 1.1
            }
        }
    }

    handle {
        # Echo Grid reads the RIGHTMOST X-Forwarded-For entry, and a trusted
        # Caddy appends rather than replaces, so send only the resolved client.
        reverse_proxy 127.0.0.1:5162 {
            header_up X-Forwarded-For {client_ip}
        }
    }
}
